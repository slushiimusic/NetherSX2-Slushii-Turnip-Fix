<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="xyz.aethersx2.tturnip" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <queries><package android:name="xyz.aethersx2.cpink02" /></queries>
    <application android:label="Daijisho Connector" android:icon="@android:drawable/ic_menu_share"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Exact component used by Daijisho's existing NetherSX2 Turnip entry.
             Daijisho checks MAIN/LAUNCHER activities before starting a game. -->
        <activity android:name="xyz.aethersx2.android.EmulationActivity"
            android:exported="true" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
